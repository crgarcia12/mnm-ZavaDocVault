<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <servlet>
        <servlet-name>HealthServlet</servlet-name>
        <servlet-class>com.zavabank.docvault.HealthServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DocVaultBootstrapServlet</servlet-name>
        <servlet-class>com.zavabank.docvault.DocVaultBootstrapServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet>
        <servlet-name>DocumentUploadServlet</servlet-name>
        <servlet-class>com.zavabank.docvault.DocumentUploadServlet</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>12582912</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet>
        <servlet-name>CustomerDocumentsServlet</servlet-name>
        <servlet-class>com.zavabank.docvault.CustomerDocumentsServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DocumentDownloadServlet</servlet-name>
        <servlet-class>com.zavabank.docvault.DocumentDownloadServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>HealthServlet</servlet-name>
        <url-pattern>/health</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DocVaultBootstrapServlet</servlet-name>
        <url-pattern>/internal/bootstrap</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DocumentUploadServlet</servlet-name>
        <url-pattern>/api/documents/upload</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CustomerDocumentsServlet</servlet-name>
        <url-pattern>/api/documents/customer/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DocumentDownloadServlet</servlet-name>
        <url-pattern>/api/documents/*</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>upload.jsp</welcome-file>
    </welcome-file-list>
</web-app>
